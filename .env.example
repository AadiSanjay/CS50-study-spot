# Supabase project URL and keys — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — only used by the local seed script (scripts/seed.ts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build the magic-link redirect. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
